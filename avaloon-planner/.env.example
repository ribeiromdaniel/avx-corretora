# Copie para .env e preencha com os dados do seu projeto Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
# Schema onde o Planner vive (padrão: planner — precisa estar em
# "Exposed schemas" nas configurações de API do projeto)
VITE_SUPABASE_SCHEMA=planner

# Secrets das Edge Functions (configurar via `supabase secrets set`, NUNCA no client):
# ANTHROPIC_API_KEY=sk-ant-...
